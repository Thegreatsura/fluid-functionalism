{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "typography",
  "title": "Typography",
  "description": "Prose styles for rendered markdown and rich-text editors (Tiptap works as is): wrap content in .typeset. Four variables (size, leading, flow, ratio) drive everything else. Zero specificity inside @layer components, so any utility wins; .not-typeset opts a subtree out; spacing only above elements, so streamed content never reflows. Presets: .typeset-docs, .typeset-chat, and .typeset-scale (every heading level set in a type role). Add .typeset-compact to step any of them down with the size ladder.",
  "css": {
    "@layer components": {
      ":where(.typeset)": {
        "--typeset-size": "1em",
        "--typeset-leading": "1.6",
        "--typeset-flow": "1",
        "--typeset-ratio": "1.2",
        "--typeset-h1": "calc(var(--typeset-ratio) * var(--typeset-ratio) * var(--typeset-ratio))",
        "--typeset-h2": "calc(var(--typeset-ratio) * var(--typeset-ratio))",
        "--typeset-h3": "var(--typeset-ratio)",
        "--typeset-h4": "1",
        "--typeset-h5": "1",
        "--typeset-h6": "0.875",
        "--typeset-h1-leading": "1.2",
        "--typeset-h2-leading": "1.25",
        "--typeset-h3-leading": "1.3",
        "--typeset-h4-leading": "var(--typeset-leading)",
        "--typeset-h5-leading": "var(--typeset-leading)",
        "--typeset-h6-leading": "var(--typeset-leading)",
        "--typeset-code": "0.875",
        "--typeset-code-leading": "1.6",
        "font-size": "var(--typeset-size)",
        "line-height": "var(--typeset-leading)",
        "overflow-wrap": "break-word"
      },
      ":where(.typeset-docs)": {
        "--typeset-size": "15px",
        "--typeset-leading": "1.65",
        "--typeset-flow": "1.1",
        "--typeset-ratio": "1.2"
      },
      ":where(.typeset-chat)": {
        "--typeset-size": "1em",
        "--typeset-leading": "1.5",
        "--typeset-flow": "0.75",
        "--typeset-ratio": "1.1"
      },
      ":where(.typeset-scale)": {
        "--typeset-size": "var(--fs-body, 13px)",
        "--typeset-leading": "1.385",
        "--typeset-flow": "1",
        "--typeset-h1": "2.154",
        "--typeset-h1-leading": "1.214",
        "--typeset-h2": "1.231",
        "--typeset-h2-leading": "1.375",
        "--typeset-h3": "1.077",
        "--typeset-h3-leading": "1.429",
        "--typeset-h4": "1",
        "--typeset-h4-leading": "1.385",
        "--typeset-h5": "0.923",
        "--typeset-h5-leading": "1.333",
        "--typeset-h6": "0.846",
        "--typeset-h6-leading": "1.273",
        "--typeset-code": "0.923",
        "--typeset-code-leading": "1.333"
      },
      ":where(.typeset-compact)": {
        "--typeset-leading": "1.55",
        "--typeset-flow": "0.8"
      },
      ":where(.typeset-docs.typeset-compact)": {
        "--typeset-size": "14px",
        "--typeset-leading": "1.6",
        "--typeset-flow": "0.88"
      },
      ":where(.typeset-chat.typeset-compact)": {
        "--typeset-leading": "1.45",
        "--typeset-flow": "0.6"
      },
      ":where(.typeset-scale.typeset-compact)": {
        "--typeset-size": "var(--fs-body-compact, 12px)",
        "--typeset-leading": "1.333",
        "--typeset-flow": "0.8",
        "--typeset-h1": "2",
        "--typeset-h1-leading": "1.25",
        "--typeset-h2": "1.25",
        "--typeset-h2-leading": "1.333",
        "--typeset-h3": "1.083",
        "--typeset-h3-leading": "1.385",
        "--typeset-h4": "1",
        "--typeset-h4-leading": "1.333",
        "--typeset-h5": "0.917",
        "--typeset-h5-leading": "1.273",
        "--typeset-h6": "0.833",
        "--typeset-h6-leading": "1.2",
        "--typeset-code": "0.917",
        "--typeset-code-leading": "1.273"
      },
      ":where(.typeset) :where(p, ul, ol, pre, blockquote, figure, table, .typeset-scroll, div, img, video, h1, h2, h3, h4, h5, h6, li):not(:where(.not-typeset, .not-typeset *))": {
        "margin": "0"
      },
      ":where(.typeset) :where(* + :is(p, ul, ol, pre, blockquote, figure, table, .typeset-scroll, div, img, video, .not-typeset)):not(:where(.not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 1em)"
      },
      ":where(.typeset) :where(p):not(:where(.not-typeset, .not-typeset *))": {
        "text-wrap": "pretty"
      },
      ":where(.typeset) :where(h1, h2, h3, h4, h5, h6):not(:where(.not-typeset, .not-typeset *))": {
        "color": "var(--foreground, currentColor)",
        "text-wrap": "balance",
        "font-variation-settings": "'wght' 550, 'opsz' 18"
      },
      ":where(.typeset) :where(h1):not(:where(.not-typeset, .not-typeset *))": {
        "font-size": "calc(1em * var(--typeset-h1))",
        "line-height": "var(--typeset-h1-leading)"
      },
      ":where(.typeset) :where(h2):not(:where(.not-typeset, .not-typeset *))": {
        "font-size": "calc(1em * var(--typeset-h2))",
        "line-height": "var(--typeset-h2-leading)"
      },
      ":where(.typeset) :where(h3):not(:where(.not-typeset, .not-typeset *))": {
        "font-size": "calc(1em * var(--typeset-h3))",
        "line-height": "var(--typeset-h3-leading)"
      },
      ":where(.typeset) :where(h4):not(:where(.not-typeset, .not-typeset *))": {
        "font-size": "calc(1em * var(--typeset-h4))",
        "line-height": "var(--typeset-h4-leading)"
      },
      ":where(.typeset) :where(h5):not(:where(.not-typeset, .not-typeset *))": {
        "font-size": "calc(1em * var(--typeset-h5))",
        "line-height": "var(--typeset-h5-leading)"
      },
      ":where(.typeset) :where(h6):not(:where(.not-typeset, .not-typeset *))": {
        "font-size": "calc(1em * var(--typeset-h6))",
        "line-height": "var(--typeset-h6-leading)"
      },
      ":where(.typeset) :where(* + h1):not(:where(.not-typeset, .not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 2em / (var(--typeset-h1)))"
      },
      ":where(.typeset) :where(* + h2):not(:where(.not-typeset, .not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 2em / (var(--typeset-h2)))"
      },
      ":where(.typeset) :where(* + h3):not(:where(.not-typeset, .not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 1.5em / (var(--typeset-h3)))"
      },
      ":where(.typeset) :where(* + h4):not(:where(.not-typeset, .not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 1.5em / (var(--typeset-h4)))"
      },
      ":where(.typeset) :where(* + h5):not(:where(.not-typeset, .not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 1.5em / (var(--typeset-h5)))"
      },
      ":where(.typeset) :where(* + h6):not(:where(.not-typeset, .not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 1.5em / (var(--typeset-h6)))"
      },
      ":where(.typeset) :where(h1 + *, h2 + *, h3 + *, h4 + *, h5 + *, h6 + *):not(:where(.not-typeset, .not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 0.5em)"
      },
      ":where(.typeset) :where(strong, b):not(:where(.not-typeset, .not-typeset *))": {
        "font-variation-settings": "'wght' 550, 'opsz' 18"
      },
      ":where(.typeset) :where(a):not(:where(.not-typeset, .not-typeset *))": {
        "color": "var(--foreground, currentColor)",
        "text-decoration-line": "underline",
        "text-decoration-color": "color-mix(in oklab, currentColor 35%, transparent)",
        "text-underline-offset": "0.2em",
        "transition": "text-decoration-color 80ms ease-out"
      },
      ":where(.typeset) :where(a:hover):not(:where(.not-typeset, .not-typeset *))": {
        "text-decoration-color": "currentColor"
      },
      ":where(.typeset) :where(ul, ol):not(:where(.not-typeset, .not-typeset *))": {
        "padding-left": "1.25em"
      },
      ":where(.typeset) :where(ul):not(:where(.not-typeset, .not-typeset *))": {
        "list-style-type": "disc"
      },
      ":where(.typeset) :where(ol):not(:where(.not-typeset, .not-typeset *))": {
        "list-style-type": "decimal"
      },
      ":where(.typeset) :where(ul ul):not(:where(.not-typeset, .not-typeset *))": {
        "list-style-type": "circle"
      },
      ":where(.typeset) :where(li):not(:where(.not-typeset, .not-typeset *))::marker": {
        "color": "var(--muted-foreground, color-mix(in oklab, currentColor 65%, transparent))"
      },
      ":where(.typeset) :where(li + li, li > ul, li > ol, li > p + p):not(:where(.not-typeset, .not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 0.25em)"
      },
      ":where(.typeset) :where(.contains-task-list, ul[data-type=\"taskList\"]):not(:where(.not-typeset, .not-typeset *))": {
        "list-style-type": "none",
        "padding-left": "0"
      },
      ":where(.typeset) :where(.contains-task-list .contains-task-list):not(:where(.not-typeset, .not-typeset *))": {
        "padding-left": "1.5em"
      },
      ":where(.typeset) :where(input[type=checkbox]):not(:where(.not-typeset, .not-typeset *))": {
        "margin": "0",
        "accent-color": "var(--foreground, currentColor)"
      },
      ":where(.typeset) :where(.task-list-item > input[type=checkbox]):not(:where(.not-typeset, .not-typeset *))": {
        "margin-right": "0.5em",
        "vertical-align": "-0.125em"
      },
      ":where(.typeset) :where(ul[data-type=\"taskList\"] > li):not(:where(.not-typeset, .not-typeset *))": {
        "display": "flex",
        "gap": "0.5em",
        "align-items": "flex-start"
      },
      ":where(.typeset) :where(ul[data-type=\"taskList\"] > li > label):not(:where(.not-typeset, .not-typeset *))": {
        "flex": "none",
        "display": "flex",
        "align-items": "center",
        "height": "calc(var(--typeset-leading) * 1em)",
        "user-select": "none"
      },
      ":where(.typeset) :where(ul[data-type=\"taskList\"] > li > div):not(:where(.not-typeset, .not-typeset *))": {
        "flex": "1 1 auto",
        "min-width": "0",
        "margin-top": "0"
      },
      ":where(.typeset) :where(ul[data-type=\"taskList\"] > li[data-checked=\"true\"] > div):not(:where(.not-typeset, .not-typeset *))": {
        "color": "var(--muted-foreground, color-mix(in oklab, currentColor 65%, transparent))",
        "text-decoration-line": "line-through",
        "text-decoration-color": "color-mix(in oklab, currentColor 50%, transparent)"
      },
      ":where(.typeset) :where(blockquote):not(:where(.not-typeset, .not-typeset *))": {
        "padding-left": "1em",
        "border-left": "2px solid var(--border, color-mix(in oklab, currentColor 14%, transparent))",
        "color": "var(--muted-foreground, color-mix(in oklab, currentColor 65%, transparent))"
      },
      ":where(.typeset) :where(hr):not(:where(.not-typeset, .not-typeset *))": {
        "border": "0",
        "border-top": "1px solid var(--border, color-mix(in oklab, currentColor 14%, transparent))",
        "margin-top": "calc(var(--typeset-flow) * 2em)"
      },
      ":where(.typeset) :where(hr + *):not(:where(.not-typeset, .not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 2em)"
      },
      ":where(.typeset) :where(code):not(:where(.not-typeset, .not-typeset *))": {
        "font-size": "calc(1em * var(--typeset-code))",
        "font-family": "var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace)"
      },
      ":where(.typeset) :where(:not(pre) > code):not(:where(.not-typeset, .not-typeset *))": {
        "background-color": "color-mix(in oklab, currentColor 7%, transparent)",
        "border-radius": "4px",
        "padding": "0.1em 0.3em"
      },
      ":where(.typeset) :where(pre):not(:where(.not-typeset, .not-typeset *))": {
        "font-size": "calc(1em * var(--typeset-code))",
        "line-height": "var(--typeset-code-leading)",
        "background-color": "color-mix(in oklab, currentColor 7%, transparent)",
        "border-radius": "8px",
        "padding": "0.75em 1em",
        "overflow-x": "auto"
      },
      ":where(.typeset) :where(* + pre):not(:where(.not-typeset, .not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 1em / (var(--typeset-code)))"
      },
      ":where(.typeset) :where(pre code):not(:where(.not-typeset, .not-typeset *))": {
        "font-size": "1em",
        "background": "none",
        "padding": "0"
      },
      ":where(.typeset) :where(kbd):not(:where(.not-typeset, .not-typeset *))": {
        "font-family": "inherit",
        "font-size": "0.85em",
        "padding": "0.1em 0.35em",
        "border-radius": "4px",
        "border": "1px solid var(--border, color-mix(in oklab, currentColor 14%, transparent))",
        "box-shadow": "0 1px 0 var(--border, color-mix(in oklab, currentColor 14%, transparent))"
      },
      ":where(.typeset) :where(table):not(:where(.not-typeset, .not-typeset *))": {
        "width": "100%",
        "border-collapse": "collapse",
        "font-variant-numeric": "tabular-nums"
      },
      ":where(.typeset) :where(th, td):not(:where(.not-typeset, .not-typeset *))": {
        "text-align": "left",
        "vertical-align": "top",
        "padding": "0.5em 0.75em",
        "border-bottom": "1px solid var(--border, color-mix(in oklab, currentColor 14%, transparent))"
      },
      ":where(.typeset) :where(th:first-child, td:first-child):not(:where(.not-typeset, .not-typeset *))": {
        "padding-left": "0"
      },
      ":where(.typeset) :where(th code, td code):not(:where(.not-typeset, .not-typeset *))": {
        "white-space": "nowrap"
      },
      ":where(.typeset) :where(th):not(:where(.not-typeset, .not-typeset *))": {
        "color": "var(--foreground, currentColor)",
        "font-variation-settings": "'wght' 550, 'opsz' 18"
      },
      ":where(.typeset) :where(.typeset-scroll, .tableWrapper):not(:where(.not-typeset, .not-typeset *))": {
        "overflow-x": "auto"
      },
      ":where(.typeset) :where(.typeset-scroll > table):not(:where(.not-typeset, .not-typeset *))": {
        "min-width": "max-content"
      },
      ":where(.typeset) :where(img, video):not(:where(.not-typeset, .not-typeset *))": {
        "max-width": "100%",
        "height": "auto",
        "border-radius": "8px"
      },
      ":where(.typeset) :where(figcaption):not(:where(.not-typeset, .not-typeset *))": {
        "margin-top": "calc(var(--typeset-flow) * 0.5em)",
        "font-size": "0.875em",
        "color": "var(--muted-foreground, color-mix(in oklab, currentColor 65%, transparent))"
      }
    }
  },
  "docs": "Docs & builder: https://www.fluidfunctionalism.com/docs/typography.",
  "categories": [
    "theme"
  ],
  "type": "registry:theme"
}
